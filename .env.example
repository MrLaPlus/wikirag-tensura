# LLM Runtime Configuration
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_LLM_PROVIDER=ollama
DEFAULT_LLM_MODEL=llama3.1:8b

# Optional Cloud LLM API Keys (Opt-in only, core path is $0)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Local Vector & Model Cache Paths
WIKIRAG_DATA_DIR=./data
SENTENCE_TRANSFORMERS_HOME=./data/cache/models

# Logging
LOG_LEVEL=INFO

# Optional API protection for non-local deployments.
# Leave disabled for normal localhost use. When enabled, send the same value
# in the X-WikiRAG-API-Token request header.
WIKIRAG_PROTECT_API=0
WIKIRAG_API_TOKEN=

# Browser origins allowed to call the API (comma-separated).
WIKIRAG_CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# LLM request timeout. Local providers may need more time than cloud APIs.
WIKIRAG_LLM_TIMEOUT_SECONDS=120
