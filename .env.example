# LLM Runtime Configuration
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_LLM_PROVIDER=ollama
DEFAULT_LLM_MODEL=llama3.1:8b

# Optional Cloud LLM API Keys (Opt-in only, core path is $0)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Local Vector & Model Cache Paths
WIKIRAG_DATA_DIR=./data
SENTENCE_TRANSFORMERS_HOME=./data/cache/models

# Logging
LOG_LEVEL=INFO
